    {
      "id": "ev-draft-jun12-yogawithin",
      "type": "restorative",
      "title": "Restorative Yoga + Living Soundscapes",
      "date": "2026-06-12",
      "time": "18:00",
      "endTime": "19:30",
      "venue": "yoga-within",
      "price": 36.75,
      "booking": "https://yogawithin.ca/restorative-yoga-soundbath",
      "contactEmail": "",
      "contactPhone": "",
      "desc": "n Mel & Marcus for a restorative yoga & healing sounds journey. Mel will lead you through a Restorative Yoga practice designed to relax and nourish the body and mind. Explore healing and supportive poses that will benefit your nervous system, ease muscular tension and release physical stress. Restorative yoga is very relaxing and slow paced.  This practice will be accompanied by Marcus Fung and his Healing Sounds experience, as we listen, sense, feel, and experience the benefits of sound, vibration, and healing music. Imagine a living, flowing tapestry of frequencies, rhythms, and sounds that soothe and regulate the nervous system, and promote the process of healing and emotional processing. The full frequency spectrum of deeply resonating sounds will help you to relax, and restore as you ground the body, clear the mind, and elevate the spirit. The perfect combination to let go, restore and renew this winter season.\n\nRecommended Props:  blocks, bolsters, blankets and straps are used so that you are supported in your pose comfortably. \n\nAll levels are welcome",
      "status": "draft",
      "venueOverride": "Roots on Whyte - 8135 102 St NW, Edmonton ",
      "img": "photos/yoga-sound.png"
    },
