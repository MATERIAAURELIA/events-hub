    {
      "id": "ev-draft-jun19-chakra",
      "type": "sound-bath",
      "title": "Clearing & Balance - A Sound Journey through the Chakras",
      "date": "2026-06-19",
      "time": "18:30",
      "endTime": "20:00",
      "venue": "home",
      "price": 60,
      "booking": "https://EarthHarmony.as.me/?appointmentType=93995396",
      "contactEmail": "",
      "contactPhone": "",
      "desc": "An immersive sound journey through a rich array of therapeutic instruments \u2014 drum, didgeridoo, flute, voice, singing bowls, and gongs. At each centre, sound helps to move what's stagnant and returns it to balance. Clearing and balancing each energy centre from the ground up. We begin at the Root in grounding and safety, then rise through creativity and flow, personal power, the open heart, voice and expression, inner sight, and finally the Crown's connection to something greater.",
      "status": "published",
      "repeatable": false,
      "venueOverride": "Terwillegar",
      "img": "https://www.google.com/imgres?q=chakras&imgurl=https%3A%2F%2Fluuckk.com%2Fcdn%2Fshop%2Farticles%2Fsignification-7-chakras_c2a2a81b-1079-47f5-8353-f08c629e80b3.webp%3Fcrop%3Dcenter%26height%3D1200%26v%3D1753878344%26width%3D1200&imgrefurl=https%3A%2F%2Fluuckk.com%2Fen-en%2Fblogs%2Farticles%2Fmeaning-each-chakra-colors-energies-blockages%3Fsrsltid%3DAfmBOooYKfNiDFJ-j9Oo3uz1bnRJRr4BXiJdPGAEouGSbR1OgLaJ1DHy&docid=hvmOj0CB_gO39M&tbnid=xIgxcsceWdtqPM&vet=12ahUKEwjDwfq1y-mUAxWlMDQIHTOfBTAQnPAOegUIhQEQAQ..i&w=1200&h=800&hcb=2&ved=2ahUKEwjDwfq1y-mUAxWlMDQIHTOfBTAQnPAOegUIhQEQAQ"
    },
